# 岁己SUI 微博监控 - 环境变量配置
# 复制为 .env 并填写实际值（全部通过环境变量读取，改完重启或用热重载生效）

# ===== 必填 =====
# 微博 Cookie（m.weibo.cn 登录后 F12 → Network → 任意请求 → 复制整段 Cookie 请求头）
WEIBO_COOKIE=WEIBOCN_FROM=...; SCF=...; SUB=...; SUBP=...; SSOLoginState=...; ALF=...; MLOGIN=1; _T_WM=...; XSRF-TOKEN=...; M_WEIBOCN_PARAMS=...

# ===== 推送通道（二选一或都用，留空则不启用该通道）=====
# Bark（iOS 原生 APNs 推送，推荐：比 Telegram 更及时，支持副标题/铃声/点击直达）
BARK_KEY=
BARK_SERVER=https://api.day.app
# 点击推送跳转地址（默认岁己微博主页）
BARK_CLICK_URL=https://m.weibo.cn/u/7785772638
# Bark 超时（秒）
BARK_TIMEOUT=8

# Telegram Bot（不填则不推送；命令交互也依赖它）
TG_BOT_TOKEN=
TG_CHAT_ID=

# ===== 可选：微博接口 =====
# 微博超话 Container ID（默认岁己SUI）
WEIBO_CONTAINERID=100808f7e22e5e7435023544d44d473e414c10

# 轮询间隔（秒）
CHECK_INTERVAL=15

# 请求超时（秒）
REQUEST_TIMEOUT=15

# 最大重试次数（网络类错误才重试；432 风控不重试直接退避）
RETRY_COUNT=3

# ===== 可选：统计口径 =====
# 日界限小时（凌晨 0 点到此小时之间归属前一天）
DAY_BOUNDARY_HOUR=8

# 统计定时刷新间隔（秒）：让"当前在线时长"持续增长、WebUI 数据不陈旧；0=关闭
STATS_REFRESH_SECONDS=300

# 状态抖动去重：某状态持续不足该秒数就切换则抑制推送（事件仍记录）；0=关闭
MIN_SESSION_SECONDS=30

# ===== 可选：风控自愈（A组）=====
# 遭遇 432 风控时的退避阶梯（秒），逐级拉长、成功后复位
BACKOFF_STEPS=60,300,900,1800

# Cookie 剩余不足该天数时主动预警
COOKIE_EXPIRE_WARN_DAYS=3

# ===== 可选：代理（受限网络下）=====
# 留空则自动读取系统 HTTPS_PROXY 环境变量
BARK_PROXY=
TELEGRAM_PROXY=http://127.0.0.1:7897

# ===== 可选：数据归档 =====
# 自动归档多少天前的事件；0=不自动归档（用 python archive_data.py 90 手动执行）
ARCHIVE_AFTER_DAYS=0

# ===== 可选：WebUI 控制接口 =====
# 留空 = 禁用控制接口（仅只读），配置后 /api/control 需带该 token
WEBUI_CONTROL_TOKEN=

# ===== 可选：日志与心跳 =====
# 日志级别 (DEBUG/INFO/WARNING/ERROR)
LOG_LEVEL=INFO

# 每日心跳摘要（每天 8 点发送；若当时未运行，启动后会补发一次）
HEARTBEAT_ENABLED=true
HEARTBEAT_HOUR=8
